{
  "name": "world-book-map",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "merge_geoms": "geojson-merge data/geometries/gadm/*.geojson > data/geometries/merged.geojson",
    "simplify_geoms": "mapshaper data/geometries/merged.geojson -simplify 10% keep-shapes -clean -o data/geometries/simplified.geojson"
  },
  "devDependencies": {
    "@mapbox/geojson-merge": "^1.1.1",
    "mapshaper": "^0.6.113"
  }
}
